{
  "functions": {
    "api/telegram.js": { "maxDuration": 60 },
    "api/reminders.js": { "maxDuration": 60 },
    "api/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/media/trainer-story-1.mp4", "destination": "https://github.com/topregnetwork-sudo/academy-strateg-trainer/releases/download/trainer-media-v1/trainer-story-1.mp4" },
    { "source": "/media/trainer-story-2.mp4", "destination": "https://github.com/topregnetwork-sudo/academy-strateg-trainer/releases/download/trainer-media-v1/trainer-story-2.mp4" }
  ],
  "headers": [
    { "source": "/media/(.*).mp4", "headers": [{ "key": "Content-Type", "value": "video/mp4" }, { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }] }
  ]
}
